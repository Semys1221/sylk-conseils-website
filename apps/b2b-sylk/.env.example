# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────────
# MODULE 2 — Tunnel de Qualification (Funnel)
# ─────────────────────────────────────────────────────────────

# N8N_WEBHOOK_URL: URL of your central N8N webhook.
# Receives funnel answers and triggers email/CRM workflows.
N8N_WEBHOOK_URL="https://your-n8n.app/webhook/your-path"

# NEXT_PUBLIC_CALENDLY_URL: Calendly booking link shown to qualified prospects.
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/sylk-conseils/30min"

# ─────────────────────────────────────────────────────────────
# MODULE 3 — Salle de Vente Interactive
# ─────────────────────────────────────────────────────────────

# NEXT_PUBLIC_DAILY_ROOM_URL: Your Daily.co room URL for the video embed.
NEXT_PUBLIC_DAILY_ROOM_URL="https://your-domain.daily.co/your-room"

# Pusher credentials for real-time slide synchronisation.
# Create a Pusher app at https://dashboard.pusher.com
NEXT_PUBLIC_PUSHER_APP_ID="1234567"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_CHANNEL_ID="sylk-conseils"

# ─────────────────────────────────────────────────────────────
# MODULE 4 — Centre de Contrôle CGP (/admin)
# ─────────────────────────────────────────────────────────────

# PostHog project key for analytics dashboard.
# Create a project at https://posthog.com (one per client)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# ADMIN_PIN: PIN code to access /admin. Min. 4 characters.
# If not set, /admin is accessible without authentication (dev mode).
ADMIN_PIN="change-me"

# ─────────────────────────────────────────────────────────────
# CMS — contenu marketing (pages publiques)
# ─────────────────────────────────────────────────────────────

# BLOB_READ_WRITE_TOKEN: Required on Vercel to persist CMS edits (Vercel Blob).
# SYLK store: b2b-sylk-cms-assets (public, 9xk9ufsvv7crsreb.public.blob.vercel-storage.com).
# Create/link in Vercel → Storage → Blob on sylk_conseils_website.
# Without it, the site uses committed defaults in content/cms/site-content.json only.
BLOB_READ_WRITE_TOKEN=""

# Vercel project targeting (compte SYLK Conseils / team sylk-conseils — indépendant d'Evan).
# Set on the Vercel project so CMS redeploy API knows which project to hit (server-only).
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
# VERCEL_ORG_ID is accepted as an alias for VERCEL_TEAM_ID.
VERCEL_ORG_ID=""
VERCEL_PROJECT_NAME="sylk_conseils_website"
# Optional admin UI label (client-safe): team slug / project name
NEXT_PUBLIC_VERCEL_PROJECT_LABEL="sylk-conseils/sylk_conseils_website"

# CLI production deploy (uploads local files): VERCEL_TOKEN=… npx vercel deploy --prod --yes --scope sylk-conseils
# One-click deploy from /admin/contenu → Déploiement (server-side only):
# - VERCEL_DEPLOY_HOOK_URL if Git is connected (Settings → Git → Deploy Hooks).
# - Otherwise VERCEL_TOKEN (token du compte SYLK) redéploie le dernier build production prêt.
VERCEL_DEPLOY_HOOK_URL=""
VERCEL_TOKEN=""
